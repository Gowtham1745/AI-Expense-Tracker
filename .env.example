# Keerthi AI Expense Tracker - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# NVIDIA Nemotron API Configuration (Optional - for AI insights)
# Get your API key from https://build.nvidia.com/
# =============================================================================
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model to use (default: nvidia/nemotron-3.5-bolt-e4b)
# Check https://build.nvidia.com/ for available models
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# API Base URL (default: NVIDIA's hosted endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Request timeout in seconds (default: 30)
NVIDIA_TIMEOUT=30

# Maximum tokens in response (default: 1024)
NVIDIA_MAX_TOKENS=1024

# =============================================================================
# Database Configuration (Optional)
# =============================================================================
# Custom database directory (default: ~/.keerthi_expense_tracker)
# KEERTHI_DB_DIR=/path/to/your/data/directory

# =============================================================================
# Application Settings (Optional)
# =============================================================================
# Default currency display (default: INR)
# DEFAULT_CURRENCY=INR

# Currency symbol (default: ₹)
# CURRENCY_SYMBOL=₹